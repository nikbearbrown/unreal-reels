# Unreal Reels — example environment file.
# Copy to .env (which is git-ignored) and fill in your real keys:
#     cp .env.example .env
# Load it into your shell before running the scripts:
#     set -a; source .env; set +a
# (or use direnv — see docs/setup.md)
#
# NEVER commit .env or paste these values into a chat. Keys are read at runtime only.

# ElevenLabs — narration text-to-speech (required for audio).  https://elevenlabs.io
ELEVENLABS_API_KEY=

# fal.ai — optional: FLUX LoRA / style training, alternate models.  https://fal.ai
FAL_KEY=

# Higgsfield does NOT use an env var here — authenticate its CLI once instead:
#     higgsfield auth login
